# --- Secrets ---
# Real config values (bot token, API key, DB password). Never commit.
.env
# Keep the template tracked: "!" means "don't ignore this one"
!.env.example

# --- Python ---
__pycache__/
*.py[cod]

# --- Virtual environments ---
venv/
.venv/
env/

# --- Testing / tooling caches ---
.pytest_cache/
.coverage
htmlcov/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Local data ---
*.log
*.sqlite3
